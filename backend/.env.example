# ---------------------------------------------------------------------------
# Murang'a Service Requests API configuration. Copy to .env (never commit it).
# The app refuses to start if a required value is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key. Safe to ship; RLS protects the data.
SUPABASE_ANON_KEY=replace-with-anon-key
# Only for LEGACY projects that sign JWTs with HS256. Leave unset for projects
# using asymmetric JWT signing keys (verified via the public JWKS).
# SUPABASE_JWT_SECRET=
SUPABASE_TIMEOUT_MS=8000

# NOTE: no SUPABASE_SERVICE_ROLE_KEY. The API never needs it (see README,
# "Security model"); do not add it to this service's environment.

# Comma-separated list of exact frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Where the email confirmation link sends users (must also be allow-listed in
# Supabase Auth -> URL Configuration -> Redirect URLs).
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Must match the CAPTCHA setting in Supabase Auth -> Attack Protection.
CAPTCHA_REQUIRED=true

# Proxies between client and API: 1 behind nginx / Render / Railway.
TRUST_PROXY_HOPS=1
BODY_LIMIT=100kb

# Optional: share rate-limit counters across instances.
# REDIS_URL=redis://localhost:6379
RATE_LIMIT_GLOBAL_MAX=300

SIGNED_URL_TTL_SECONDS=600
SHUTDOWN_TIMEOUT_MS=15000
