# Frontend configuration. Everything prefixed VITE_ is embedded in the public
# JS bundle, so ONLY public values belong here (never service_role keys).

# Backend REST API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000

# Supabase project URL and PUBLIC anon key (Auth + Realtime only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Cloudflare Turnstile site key (public). Leave empty to disable the widget
# locally; must be set in production when CAPTCHA is enabled in Supabase.
VITE_TURNSTILE_SITE_KEY=
